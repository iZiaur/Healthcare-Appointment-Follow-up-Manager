# Database
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"

# Google Calendar OAuth (Stage 8)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# LLM Configuration (Stage 5)
# Set to 'stub' for local dev without an API key, or 'gemini' for production
LLM_PROVIDER="stub"
GEMINI_API_KEY="your-gemini-api-key"

# Email Configuration (Stage 7)
# Set to 'stub' for local dev (prints to console), or 'nodemailer' for production
EMAIL_PROVIDER="stub"
SMTP_URL="smtps://user:pass@smtp.example.com"
