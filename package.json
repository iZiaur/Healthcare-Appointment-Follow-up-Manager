{
  "name": "healthcare",
  "version": "1.0.0",
  "description": "Healthcare Appointment & Follow-up Manager",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy:render": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/prisma/build/index.js migrate deploy && next build",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:seed": "node ./node_modules/prisma/build/index.js db seed",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:reset": "node ./node_modules/prisma/build/index.js migrate reset --force",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs watch",
    "jobs": "ts-node src/jobs/scheduler.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "healthcare",
    "appointments",
    "clinic"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^7.9.1",
    "@types/nodemailer": "^8.0.1",
    "date-fns": "^4.4.0",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.3.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
